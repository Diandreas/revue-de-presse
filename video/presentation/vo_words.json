"phrases": [
{
"p": 0,
"label": "A",
"t0": 0.6,
"t1": 3.942,
"beat": 1,
"text": "Chaque matin, des dizaines de journaux arrivent sur votre bureau."
},
{
"p": 1,
"label": "B",
"t0": 4.5,
"t1": 6.827,
"beat": 7.5,
"text": "Lesquels comptent vraiment pour votre entreprise"
},
{
"p": 2,
"label": "C",
"t0": 7.8,
"t1": 10.762,
"beat": 13,
"text": "Avec Revue de Presse, vous le savez en quelques minutes."
},
{
"p": 3,
"label": "D1",
"t0": 12.0,
"t1": 14.317,
"beat": 20,
"text": "Photographiez les unes avec votre téléphone,"
},
{
"p": 4,
"label": "D2",
"t0": 14.55,
"t1": 15.837,
"beat": 24.25,
"text": "ou déposez vos PDF."
},
{
"p": 5,
"label": "E1",
"t0": 17.1,
"t1": 19.607,
"beat": 28.5,
"text": "L'intelligence artificielle lit chaque page,"
},
{
"p": 6,
"label": "E2",
"t0": 19.95,
"t1": 21.232,
"beat": 33.25,
"text": "résume chaque article,"
},
{
"p": 7,
"label": "E3",
"t0": 21.6,
"t1": 23.182,
"beat": 36,
"text": "et repère ce qui vous concerne."
},
{
"p": 8,
"label": "F1",
"t0": 24.0,
"t1": 25.482,
"beat": 40,
"text": "Votre revue de presse est prête,"
},
{
"p": 9,
"label": "F2",
"t0": 25.8,
"t1": 27.047,
"beat": 43,
"text": "au format que vous connaissez"
},
{
"p": 10,
"label": "F3",
"t0": 27.6,
"t1": 28.402,
"beat": 46,
"text": "par rubrique,"
},
{
"p": 11,
"label": "F4",
"t0": 28.8,
"t1": 30.747,
"beat": 48,
"text": "du journal le plus lu au moins connu."
},
{
"p": 12,
"label": "G1",
"t0": 33.6,
"t1": 34.712,
"beat": 56,
"text": "Risques juridiques,"
},
{
"p": 13,
"label": "G2",
"t0": 34.95,
"t1": 35.667,
"beat": 58.25,
"text": "intox,"
},
{
"p": 14,
"label": "G3",
"t0": 36.0,
"t1": 37.122,
"beat": 60,
"text": "annonces de vos concurrents"
},
{
"p": 15,
"label": "G4",
"t0": 37.8,
"t1": 40.547,
"beat": 63,
"text": "les passages sensibles sont surlignés et expliqués."
},
{
"p": 16,
"label": "H1",
"t0": 41.1,
"t1": 43.352,
"beat": 68.5,
"text": "Exportez-la en Word ou en PDF,"
},
{
"p": 17,
"label": "H2",
"t0": 43.5,
"t1": 45.382,
"beat": 72.5,
"text": "et partagez-la avec votre direction."
},
{
"p": 18,
"label": "I1",
"t0": 45.9,
"t1": 47.037,
"beat": 76.5,
"text": "Invitez votre équipe,"
},
{
"p": 19,
"label": "I2",
"t0": 47.1,
"t1": 49.287,
"beat": 78.5,
"text": "et choisissez ce que l'IA doit surveiller."
},
{
"p": 20,
"label": "J1",
"t0": 50.4,
"t1": 51.292,
"beat": 84,
"text": "Revue de Presse"
},
{
"p": 21,
"label": "J2",
"t0": 51.6,
"t1": 53.902,
"beat": 86,
"text": "votre veille média, augmentée par l'IA."
},
{
"p": 22,
"label": "K",
"t0": 54.3,
"t1": 57.542,
"beat": 90.5,
"text": "Sept jours d'essai gratuit, ou une démo sur WhatsApp."
}
]
