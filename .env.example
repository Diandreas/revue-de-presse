# Copiez ce fichier vers .env et ajustez les valeurs. Tous les secrets ci-dessous
# ont un comportement de repli sûr en local (DEBUG=True) : le pipeline IA utilise
# un client Mistral factice et les fournisseurs de paiement passent en mode "mock"
# tant que les vraies clés ne sont pas fournies.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev
FRONTEND_BASE_URL=http://localhost:5173
# Sécurité (voir docs/securite.md). En production : DJANGO_SECRET_KEY aléatoire d'au moins
# 50 caractères (config.settings.prod refuse de démarrer sinon), admin sur un chemin secret
# (ex. gestion-7f3k9q/), 1 proxy de confiance (nginx) pour lire l'IP réelle des clients.
DJANGO_ADMIN_URL=admin/
# DJANGO_NUM_PROXIES=1
# Fichiers clients : durée de vie des liens signés (s) ; X-Accel-Redirect vers nginx en prod.
# MEDIA_URL_MAX_AGE=1800
# MEDIA_X_ACCEL_REDIRECT=True

# --- Base de données (Postgres) ---
POSTGRES_DB=revue_de_presse
POSTGRES_USER=revue
POSTGRES_PASSWORD=revue
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://revue:revue@db:5432/revue_de_presse

# --- Redis / Celery ---
# REDIS_URL = cache Django (compteurs de la limitation de débit). Base dédiée conseillée en
# prod (ex. redis://127.0.0.1:6379/2). Ignorée en dev (cache en mémoire) sauf
# DJANGO_DEV_REDIS_CACHE=True.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Dev sans Redis ni Docker : CELERY_BROKER_URL=filesystem://  (+ worker `-P solo`, voir docs/pipeline.md)
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Mistral AI ---
# REQUIS pour un vrai pipeline IA. Vide -> FakeMistralClient (sortie factice labellisée).
MISTRAL_API_KEY=
# Modèle d'analyse du texte. La disponibilité dépend de l'offre du compte Mistral :
# un modèle fermé à l'offre répond 403 "tier_not_allowed", ou 429 avec un quota de 0
# requête/minute (en-tête x-ratelimit-limit-req-minute: 0) — le job passe alors en FAILED
# avec un message explicite. Les modèles ministral-* sont ouverts aux offres gratuites ;
# pour une meilleure qualité, mistral-small-latest / mistral-large-latest (offres payantes).
MISTRAL_MODEL=ministral-8b-latest
# Modèle de VISION qui lit les photos et PDF scannés (capacité « vision » requise).
MISTRAL_VISION_MODEL=ministral-8b-latest
# Lecture des photos : auto = Mistral si MISTRAL_API_KEY est renseignée, sinon Tesseract
# (local, à installer : tesseract-ocr + données « fra » + poppler-utils). Valeurs : auto|mistral|tesseract
OCR_ENGINE=auto

# --- Stripe (paiement carte) ---
# REQUIS pour un vrai flux Stripe. Vide -> StripeProvider en mode mock.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# --- CamPay (Mobile Money : MTN MoMo + Orange Money) ---
# REQUIS pour un vrai flux Mobile Money. Vide -> CamPayProvider en mode mock.
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_BASE_URL=https://demo.campay.net/api

# --- Email (dev : Mailpit) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@revue-de-presse.local

# --- Frontend (Vite) ---
# Vide = requêtes relatives (/api/...), proxyées par Vite vers localhost:8000 en dev.
# En prod, si le frontend et le backend ne partagent pas la même origine, renseignez
# l'URL absolue du backend (ex: https://api.example.com).
VITE_API_BASE_URL=
