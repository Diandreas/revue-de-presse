# Copiez ce fichier vers .env et ajustez les valeurs. Tous les secrets ci-dessous
# ont un comportement de repli sûr en local (DEBUG=True) : le pipeline IA utilise
# un client Mistral factice et les fournisseurs de paiement passent en mode "mock"
# tant que les vraies clés ne sont pas fournies.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev
FRONTEND_BASE_URL=http://localhost:5173
# Sécurité (voir docs/securite.md). En production : DJANGO_SECRET_KEY aléatoire d'au moins
# 50 caractères (config.settings.prod refuse de démarrer sinon), admin sur un chemin secret
# (ex. gestion-7f3k9q/), 1 proxy de confiance (nginx) pour lire l'IP réelle des clients.
DJANGO_ADMIN_URL=admin/
# DJANGO_NUM_PROXIES=1
# Fichiers clients : durée de vie des liens signés (s) ; X-Accel-Redirect vers nginx en prod.
# MEDIA_URL_MAX_AGE=1800
# MEDIA_X_ACCEL_REDIRECT=True
# Version des CGU/CGV + politique de confidentialité acceptées à l'inscription (enregistrée
# sur chaque compte). À changer à chaque nouvelle version publiée des textes.
TERMS_VERSION=2026-10-11

# --- Base de données (Postgres) ---
POSTGRES_DB=revue_de_presse
POSTGRES_USER=revue
POSTGRES_PASSWORD=revue
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://revue:revue@db:5432/revue_de_presse

# --- Redis / Celery ---
# REDIS_URL = cache Django (compteurs de la limitation de débit). Base dédiée conseillée en
# prod (ex. redis://127.0.0.1:6379/2). Ignorée en dev (cache en mémoire) sauf
# DJANGO_DEV_REDIS_CACHE=True.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# Dev sans Redis ni Docker : CELERY_BROKER_URL=filesystem://  (+ worker `-P solo`, voir docs/pipeline.md)
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Mistral AI ---
# REQUIS pour un vrai pipeline IA. Vide -> FakeMistralClient (sortie factice labellisée).
MISTRAL_API_KEY=
# Modèle d'analyse du texte. La disponibilité dépend de l'offre du compte Mistral :
# un modèle fermé à l'offre répond 403 "tier_not_allowed", ou 429 avec un quota de 0
# requête/minute (en-tête x-ratelimit-limit-req-minute: 0) — le job passe alors en FAILED
# avec un message explicite. Les modèles ministral-* sont ouverts aux offres gratuites ;
# pour une meilleure qualité, mistral-small-latest / mistral-large-latest (offres payantes).
MISTRAL_MODEL=ministral-8b-latest
# Modèle de VISION qui lit les photos et PDF scannés (capacité « vision » requise).
MISTRAL_VISION_MODEL=ministral-8b-latest
# Lecture des photos : auto = Mistral si MISTRAL_API_KEY est renseignée, sinon Tesseract
# (local, à installer : tesseract-ocr + données « fra » + poppler-utils). Valeurs : auto|mistral|tesseract
OCR_ENGINE=auto
# Clé vide : client factice [MOCK] autorisé seulement en DEBUG (non renseigné). En production,
# laisser vide pour que les revues échouent avec un message d'administrateur plutôt que [MOCK].
# MISTRAL_ALLOW_FAKE_CLIENT=
# Points clés : modèle (défaut = MISTRAL_REVIEW_MODEL), température, filtres avant enregistrement.
# MISTRAL_HIGHLIGHT_MODEL=ministral-14b-latest
# HIGHLIGHT_TEMPERATURE=0
# HIGHLIGHT_MIN_CONFIDENCE=0.5
# HIGHLIGHT_MIN_EXCERPT_WORDS=3
# HIGHLIGHT_EXCERPT_MIN_SIMILARITY=0.88
# Limiteur de débit des appels Mistral (requêtes/minute, 0 = sans limite), via le cache Django.
# AI_RATE_LIMIT_GLOBAL_PER_MINUTE=60
# AI_RATE_LIMIT_ORG_PER_MINUTE=30
# AI_RATE_LIMIT_MAX_WAIT_SECONDS=90
# AI_RATE_LIMIT_CACHE=default
# Plafonds par revue selon la formule (JSON par code de formule) et pages max d'un PDF.
# AI_MAX_PDF_PAGES=100
# AI_REVIEW_LIMITS={"default":{"max_documents":40,"max_pages":80},"starter":{"max_documents":30,"max_pages":60},"pro":{"max_documents":50,"max_pages":150},"enterprise":{"max_documents":80,"max_pages":300}}
# Journal des appels IA (admin « appels IA ») et tarifs $/million de jetons [entrée, sortie].
# AI_USAGE_TRACKING=true
# AI_TOKEN_PRICES_USD={"ministral-14b-latest":[0.2,0.2]}

# --- Stripe (paiement carte) ---
# REQUIS pour un vrai flux Stripe. Vide -> StripeProvider en mode mock.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# --- CamPay (Mobile Money : MTN MoMo + Orange Money) ---
# REQUIS pour un vrai flux Mobile Money. Vide -> CamPayProvider en mode mock.
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_BASE_URL=https://demo.campay.net/api

# --- Facturation ---
# manual (défaut) : aucun paiement en ligne — le client contacte l'équipe sur WhatsApp et
# le staff active / prolonge l'abonnement dans /admin/ (voir docs/facturation-manuelle.md).
# online : réactive les parcours Stripe / Mobile Money / virement en libre-service.
BILLING_MODE=manual
# Jours d'accès conservés après la fin d'une période payée (l'essai, lui, s'arrête net).
BILLING_GRACE_DAYS=3
BILLING_CONTACT_WHATSAPP=+237 693 42 79 13
# Factures : préfixe de numérotation (RDP-2026-0001), taux de TVA en % (0 = « TVA non
# applicable ») et identité légale du vendeur imprimée sur chaque facture. À valider
# avec un comptable AVANT la première facture (elles sont figées à l'émission).
BILLING_INVOICE_PREFIX=RDP
BILLING_VAT_RATE=19.25
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_RCCM=
BILLING_SELLER_NIU=
BILLING_SELLER_EMAIL=

# --- Email (dev : Mailpit) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@revue-de-presse.local

# --- Frontend (Vite) ---
# Vide = requêtes relatives (/api/...), proxyées par Vite vers localhost:8000 en dev.
# En prod, si le frontend et le backend ne partagent pas la même origine, renseignez
# l'URL absolue du backend (ex: https://api.example.com).
VITE_API_BASE_URL=
